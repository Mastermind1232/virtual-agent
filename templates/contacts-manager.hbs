{{!-- NuNu packaging: the GM's book of everyone the party can call. --}}
<div class="nunu-contacts-body">

    <div class="nc-toolbar">
        <label>Sort
            <select data-sort>
                <option value="name" {{#if (eq sort "name")}}selected{{/if}}>Name</option>
                <option value="faction" {{#if (eq sort "faction")}}selected{{/if}}>Affiliation</option>
                <option value="standing" {{#if (eq sort "standing")}}selected{{/if}}>Attitude</option>
            </select>
        </label>
        <button type="button" data-new><i class="fas fa-plus"></i> New contact</button>
    </div>

    {{#each contacts}}
    <div class="nc-card {{#if this.open}}is-open{{/if}}" data-card>

        <div class="nc-row" data-open="{{this.id}}">
            <img src="{{#if this.avatar}}{{this.avatar}}{{else}}icons/svg/mystery-man.svg{{/if}}" alt="">
            <span class="nc-who">
                <span class="nc-name">{{this.name}}</span>
                <span class="nc-sub">
                    <span class="nc-chip" style="color: {{this.standingColour}};">{{#if this.faction}}{{this.faction}}{{else}}Unaffiliated{{/if}}</span>
                    {{#if this.role}}<span class="nc-role">{{this.role}}</span>{{/if}}
                    <span class="nc-standing">{{this.standingLabel}}</span>
                    {{#unless this.hasActor}}<span class="nc-warn">needs an actor</span>{{/unless}}
                </span>
            </span>
            <span class="nc-holders">{{#if this.holderNames}}{{this.holderNames}}{{else}}on nobody's phone{{/if}}</span>
        </div>

        {{#if this.open}}
        <div class="nc-edit">
            <div class="nc-fields">
                <label class="nc-actor-field">Actor sheet
                    <select data-field="actor">
                        <option value="">Not linked yet</option>
                        {{#each ../actors}}<option value="{{this.uuid}}" {{#if (eq this.uuid ../this.actorUuid)}}selected{{/if}}>{{this.name}}</option>{{/each}}
                    </select>
                </label>
                <label>Name{{#if this.hasActor}} <span class="nc-hint">from the sheet</span>{{/if}}<input type="text" data-field="name" value="{{this.name}}" {{#if this.hasActor}}readonly{{/if}}></label>
                <label>Affiliation<input type="text" data-field="faction" value="{{this.faction}}" placeholder="AGPD, Fenixxx, The Bunnies…"></label>
                <label>Role{{#if this.roleFromSheet}} <span class="nc-hint">from the sheet</span>{{/if}}
                    {{#if this.roleFromSheet}}
                    <input type="text" data-field="role" value="{{this.role}}" readonly>
                    {{else}}
                    <select data-field="role">
                        <option value="">N/A</option>
                        {{#each ../roles}}<option value="{{this}}" {{#if (eq this ../this.role)}}selected{{/if}}>{{this}}</option>{{/each}}
                    </select>
                    {{/if}}
                </label>
                <label>Attitude to the party
                    <select data-field="standing">
                        {{#each ../standings}}<option value="{{this.id}}" {{#if (eq this.id ../this.standing)}}selected{{/if}}>{{this.label}}</option>{{/each}}
                    </select>
                </label>
                <label class="nc-operator">
                    <input type="checkbox" data-field="operator" {{#if this.isOperator}}checked{{/if}}>
                    <span>Works for the Operator</span>
                    <span class="nc-op-note">{{#if this.isOperator}}on the roster{{else}}{{#if this.hasActor}}can be sent on gigs{{else}}link an actor first{{/if}}{{/if}}</span>
                </label>
                <label class="nc-avatar">Portrait
                    <span class="nc-avatar-row">
                        <input type="text" data-field="avatar" value="{{this.avatar}}" placeholder="Image path">
                        <button type="button" data-browse title="Browse"><i class="fas fa-file-import"></i></button>
                    </span>
                </label>
            </div>

            <div class="nc-party">
                <span class="nc-party-label">Who has their number</span>
                <div class="nc-party-grid">
                    {{#each this.party}}
                    <label class="nc-person">
                        <input type="checkbox" data-holder="{{this.id}}" {{#if this.has}}checked{{/if}}>
                        <img src="{{this.img}}" alt="">
                        <span>{{this.name}}</span>
                    </label>
                    {{/each}}
                </div>
            </div>

            <div class="nc-actions">
                <button type="button" class="nc-danger" data-delete="{{this.id}}"><i class="fas fa-trash"></i> Delete</button>
                <button type="button" class="nc-save" data-save="{{this.id}}"><i class="fas fa-check"></i> Save</button>
            </div>
        </div>
        {{/if}}

    </div>
    {{else}}
    <p class="nc-empty">Nobody in the book yet. Add a contact and tick who has their number.</p>
    {{/each}}

</div>
